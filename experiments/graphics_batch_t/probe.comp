#version 450

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer Data {
    vec4 values[];
} data;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    vec4 v = data.values[i];
    for (uint k = 0; k < 8; ++k) {
        v = fma(v, vec4(1.25, 0.75, 1.5, 0.625), vec4(float(k)));
        v += vec4(0.125, 0.25, 0.5, 0.0625);
    }
    data.values[i] = v;
}
